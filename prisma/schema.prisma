generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model Category {
    id            String   @id @default(uuid())
    category_name String
    createdAt     DateTime @default(now()) // บันทึกเวลาที่สร้าง
    updatedAt     DateTime @default(now()) @updatedAt // อัปเดตเวลาเมื่อมีการแก้ไข
}


model User {
    id       String @id @default(uuid())
    name     String
    email    String @unique
    password String
}
